<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: правила backup и transfer -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Исключаем секреты и логи из облачного бэкапа -->
        <exclude domain="sharedpref" path="vpnproxy_subscriptions.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="hev_config.yaml" />
    </cloud-backup>
    <device-transfer>
        <!-- При переносе на другое устройство тоже не переносим подписки -->
        <exclude domain="sharedpref" path="vpnproxy_subscriptions.xml" />
    </device-transfer>
</data-extraction-rules>
