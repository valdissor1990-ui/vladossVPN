<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: правила backup и transfer -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Исключаем секреты и логи из облачного бэкапа -->
        <exclude domain="sharedpref" path="vpnproxy_subscriptions.xml" />
        <exclude domain="sharedpref" path="vpnproxy_json_servers_v1.xml" />
        <exclude domain="sharedpref" path="device_id_prefs.xml" />
        <exclude domain="sharedpref" path="vpnproxy_last_server.xml" />
        <exclude domain="sharedpref" path="pending_update.xml" />
        <exclude domain="sharedpref" path="update_checker_prefs.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="crashes/" />
        <exclude domain="file" path="cached_configs.json" />
        <exclude domain="file" path="hev_config.yaml" />
    </cloud-backup>
    <device-transfer>
        <!-- При переносе на другое устройство тоже не переносим секреты и логи -->
        <exclude domain="sharedpref" path="vpnproxy_subscriptions.xml" />
        <exclude domain="sharedpref" path="vpnproxy_json_servers_v1.xml" />
        <exclude domain="sharedpref" path="device_id_prefs.xml" />
        <exclude domain="sharedpref" path="vpnproxy_last_server.xml" />
        <exclude domain="sharedpref" path="pending_update.xml" />
        <exclude domain="sharedpref" path="update_checker_prefs.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="crashes/" />
        <exclude domain="file" path="cached_configs.json" />
        <exclude domain="file" path="hev_config.yaml" />
    </device-transfer>
</data-extraction-rules>
