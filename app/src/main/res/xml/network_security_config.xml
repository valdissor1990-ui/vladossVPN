<?xml version="1.0" encoding="utf-8"?>
<!--
  Hardening: cleartext disabled system-wide for the app process.
  Subscription and update traffic must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
