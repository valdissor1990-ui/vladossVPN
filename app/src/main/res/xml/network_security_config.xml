<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is disabled app-wide. Subscription, update and probe traffic
  must use TLS. Debug builds may additionally trust user-installed CAs for
  local inspection; release builds trust only the system store.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
