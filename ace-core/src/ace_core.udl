// Stage B: flat callback signature (not AceEvent enum).
// Enum events may return in Stage C/D when real event types exist.
namespace ace_core {
    string ace_version();

    [Throws=AceError]
    void ace_initialize(AceListener? listener);

    [Throws=AceError]
    void ace_shutdown();

    [Throws=AceError]
    string ace_ping();

    [Throws=AceError]
    void ace_emit_test_event(string payload);

    [Throws=AceError]
    void ace_trigger_test_panic();
};

[Error]
enum AceError {
    "NotInitialized",
    "Panic",
    "Internal",
};

callback interface AceListener {
    void on_event(string event, string payload);
};
